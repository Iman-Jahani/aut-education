# Copy this file to .env.local and adjust if needed.
# These are the same Supabase URL / anon key already used in your old admin-5.html / class-23.html,
# so the app works with your existing tables immediately. The anon key is meant to be public
# (Row Level Security in Supabase is what actually protects your data).

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Password to open /admin. Change this! The page is now additionally protected by
# the auth middleware: only accounts with role = "teacher" can reach /admin at all,
# and this password stays as a second (client-side) gate on top of that.
NEXT_PUBLIC_ADMIN_PASSWORD=""

# Auth model (see supabase/AUTH_MIGRATION.md):
#   students sign in with <student_code>@students.local + password
#   teachers sign in with a real email + password; the "teacher" role is granted
#   server-side by an invite code stored in the teacher_invites table (SQL),
#   so nothing here can be tampered with from the browser.

